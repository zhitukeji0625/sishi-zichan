DATABASE_URL="mysql://root:root@127.0.0.1:3306/sishi"
# 若使用非 Docker 的 MySQL，请改为实际账号，例如 mysql://user:password@127.0.0.1:3306/sishi
SESSION_SECRET="generate-a-long-random-string"
THIRD_PARTY_JWT_SECRET="hmac-secret-for-third-party-tokens"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# 本地 http://localhost 开发保持 false；HTTPS 部署设为 true
COOKIE_SECURE="false"
